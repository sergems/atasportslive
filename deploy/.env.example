# =============================================================================
# ATA Platform — Production Environment Variables
# Copy this file to .env in the project root and fill in real values.
# NEVER commit the real .env file to version control.
# =============================================================================

# ── Database ──────────────────────────────────────────────────────────────────
# Strong random password for PostgreSQL (min 32 chars)
# Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=change_me_to_a_strong_random_password

# ── Application ───────────────────────────────────────────────────────────────
# Strong random secret for JWT signing (min 64 chars)
# Generate with: openssl rand -base64 64
SESSION_SECRET=change_me_to_a_strong_random_session_secret

# Public base URL of the website. Used to build password-reset links in emails.
APP_BASE_URL=https://atasportslive.com

# ── Email delivery (Resend) ──────────────────────────────────────────────────
# When RESEND_API_KEY is set, ALL outgoing email uses Resend's HTTPS API
# instead of the SMTP settings below (useful when SMTP ports are blocked).
# Get a key at https://resend.com/api-keys and verify your sending domain.
RESEND_API_KEY=
# Verified sender address, e.g. ATA Sports Live <no-reply@atasportslive.com>
RESEND_FROM=

# ── Android in-app purchases (RevenueCat) ────────────────────────────────────
# Secret used to verify RevenueCat webhooks at POST /api/webhooks/revenuecat.
# Generate a long random string and paste the same value into the RevenueCat dashboard.
REVENUECAT_WEBHOOK_SECRET=change_me_to_a_long_random_secret

# ── Weekly Backup Email Notification ─────────────────────────────────────────
# SMTP server used to send the weekly backup notification email.
# Gmail example: use an App Password (not your regular password).
#   → https://myaccount.google.com/apppasswords
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail-address@gmail.com
SMTP_PASS=your-gmail-app-password

# Recipient of the weekly backup notification
NOTIFY_EMAIL=info@atasportslive.com
